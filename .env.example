# ==== Парсер Авито ====
# Отслеживаемые ссылки: одна или несколько через запятую / точку с запятой / перенос строки
AVITO_TARGET_URL=https://www.avito.ru/moskva/avtomobili
# Файл со ссылками (по одной на строку, строки с # — комментарий). Ссылки из файла
# добавляются к AVITO_TARGET_URL и не дублируются.
SOURCES_FILE=

# Режим браузера без окна (True для Docker)
HEADLESS_MODE=True
# Задержки между действиями человека, сек
DELAY_MIN=2
DELAY_MAX=5
# Паузы между переходами по страницам объявлений, сек
INTER_PAGE_PAUSE_MIN=6
INTER_PAGE_PAUSE_MAX=14
TIMEOUT=30
# Сколько ждать отрисовки карточек выдачи (это SPA, контент появляется после JS)
RENDER_TIMEOUT=45

# Ротация User-Agent между сессиями браузера
ROTATE_USER_AGENT=True
# Прокси опционально: login:pass@ip:port, socks5://ip:port (список через запятую = пул)
PROXY_STRING=
# Все прокси забанены — продолжить работу напрямую (иначе прогон останавливается)
PROXY_ALLOW_DIRECT=True
# Проверять доступность прокси перед стартом
PROXY_CHECK_ALIVE=True

# Детали и фотографии
PARSE_DETAILS=True
DOWNLOAD_PHOTOS=True
MAX_PHOTOS_PER_AD=5
PHOTOS_DIR=data/photos
# 0 = без лимита / парсить детали у всех новых
MAX_ADS_PER_RUN=0
DETAILS_SAMPLE=0

# Поведение при блокировке
MAX_RETRIES=2
BLOCK_BACKOFF_BASE=60
BLOCK_BACKOFF_MAX=180
# «Доступ ограничен: проверка безопасности» — JS-челлендж, ждём снятия, а не перезапускаем
CHALLENGE_WAIT=40

# ==== Хранилище ====
DB_PATH=avito.db

# ==== ВКонтакте (публикация объявлений в сообщество) ====
# Ключ сообщества: сообщество → Управление → Работа с API →
# «Сключить доступ к сайту» → права: photos, wall, groups — скопировать ключ
VK_ACCESS_TOKEN=
# id сообщества (число, можно со знаком минус) или его короткий адрес: myclub / -217128695
VK_GROUP_ID=
VK_APP_ID=1234567
VK_API_VERSION=5.199
# Не чаще одного поста в N секунд (ТЗ: 3-5 минут)
VK_POST_MIN_INTERVAL_SEC=240
# Шаблон текста поста; доступны {title} {price} {description} {url} {location} {id} {date}
VK_POST_TEMPLATE={title}\nЦена: {price}\n\n{description}\n\nСсылка: {url}
# Сколько фото в пост (VK принимает до 10)
VK_MAX_PHOTOS_PER_POST=10
# Описание с Авито бывает до 8000 знаков — в пост берём начало
VK_MAX_DESCRIPTION_LENGTH=1200
VK_MAX_MESSAGE_LENGTH=7500
# Пропускать объявления без фотографий (посты без картинки тонут в ленте)
VK_REQUIRE_PHOTOS=True
# Если парсер не скачал фото — докачать их перед публикацией
VK_DOWNLOAD_PHOTOS=True
# Закрывать комментарии в постах
VK_DISABLE_COMMENTS=False
# Хэштеги в конец поста, например "#авито #саранск"
VK_HASHTAGS=
VK_REQUEST_TIMEOUT=30
VK_UPLOAD_TIMEOUT=120
# Отдельный прокси для запросов к VK (по пусто: VK не блокирует, а датацентровые
# адреса от Авито только портят загрузку фото)
VK_PROXY_STRING=

# ==== Планировщик ====
CHECK_INTERVAL_MINUTES=10

# ==== Логи ====
LOG_LEVEL=INFO
LOG_FILE=logs/avito_parser.log

# ==== Админка (webui) ====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_SECRET=generate-with-openssl-rand-hex-32

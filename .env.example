# ==== Домен (только для Caddy/HTTPS) ====
DOMAIN=

# ==== Django ====
# В Docker DEBUG выключен. Для локальной отладки можно поставить 1.
DEBUG=0
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
# 1 — если приложение работает за HTTPS-прокси (Caddy/Nginx)
HTTPS=0

# ==== PostgreSQL ====
# Если POSTGRES_DB не задан, локально используется SQLite в data/db.sqlite3.
POSTGRES_DB=avito_mvp
POSTGRES_USER=avito
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ==== Шифрование токенов VK ====
# Сгенерировать:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ==== VK ====
VK_API_VERSION=5.199
VK_REQUEST_TIMEOUT=30
VK_UPLOAD_TIMEOUT=120
VK_POST_MIN_INTERVAL_SEC=240
VK_MAX_MESSAGE_LENGTH=8000

# ==== Авито ====
AVITO_HEADLESS=1
AVITO_PAGE_TIMEOUT=40
AVITO_RENDER_TIMEOUT=30
AVITO_PHOTO_TIMEOUT=30
# Постоянный профиль Chrome: сохраняет куки Авито между задачами.
# Пусто — временный профиль на каждую задачу.
AVITO_PROFILE_DIR=data/chrome-profile
# Прокси с перехватом TLS: отключить проверку сертификата для запросов через прокси
PROXY_INSECURE_TLS=1
MAX_PHOTOS_PER_POST=10
PHOTO_MAX_BYTES=20971520

# Для Docker пути уже заданы в образе. Для локального запуска можно не задавать:
# Selenium Manager попробует найти Chrome сам.
CHROME_BIN=
CHROMEDRIVER_PATH=

LOG_LEVEL=INFO
